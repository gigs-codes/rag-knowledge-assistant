data/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/tests/
backend/eval/
backend/mcp_server/
frontend/node_modules/
frontend/dist/
working demo.mp4
